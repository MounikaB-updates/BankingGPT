{
  "schema_version": "1.0",
  "artifact_version": "1.0.0",
  "name": "lookup_member_profile",
  "description": "Find a fictional member and return their display name and membership status.",
  "application": "mock-bank",
  "surface_type": "browser",
  "entry_point": "http://127.0.0.1:8000/",
  "inputs": [
    {"name": "member_id", "type": "string", "description": "Fictional internal member identifier", "required": true, "sensitive": true}
  ],
  "outputs": [
    {"name": "member_name", "type": "string", "description": "Displayed fictional member name", "sensitive": true},
    {"name": "member_status", "type": "string", "description": "Displayed membership status", "sensitive": false}
  ],
  "allowed_hosts": ["127.0.0.1", "localhost"],
  "steps": [
    {
      "id": "enter-member-id", "action": "fill",
      "target": [{"strategy": "label", "value": "Member ID", "exact": true, "priority": 1}, {"strategy": "css", "value": "#member-id", "exact": true, "priority": 2}],
      "value": "{{member_id}}", "risk": "read_only",
      "retry": {"max_attempts": 2, "delay_seconds": 0.25}, "description": "Enter the member identifier"
    },
    {
      "id": "submit-search", "action": "click",
      "target": [{"strategy": "role", "value": "button", "name": "Search", "exact": true, "priority": 1}],
      "risk": "read_only", "retry": {"max_attempts": 2, "delay_seconds": 0.25}, "description": "Submit the member search"
    },
    {
      "id": "extract-member-name", "action": "extract",
      "target": [{"strategy": "test_id", "value": "member-name", "exact": true, "priority": 1}],
      "output_name": "member_name", "risk": "read_only", "description": "Read the member name"
    },
    {
      "id": "extract-member-status", "action": "extract",
      "target": [{"strategy": "test_id", "value": "member-status", "exact": true, "priority": 1}],
      "output_name": "member_status", "risk": "read_only", "description": "Read the member status"
    }
  ],
  "business_outcomes": [
    {"code": "member_not_found", "locator": {"strategy": "test_id", "value": "member-not-found", "exact": true, "priority": 1}, "message": "No member exists with the supplied identifier."},
    {"code": "permission_denied", "locator": {"strategy": "test_id", "value": "permission-denied", "exact": true, "priority": 1}, "message": "The current operator is not permitted to view this member."}
  ],
  "success_checkpoint": {"strategy": "test_id", "value": "member-details-heading", "exact": true, "priority": 1},
  "approval_status": "approved"
}
